# ============================================================================
# SentinelSRE environment template — copy to .env and fill in your own values.
# NEVER commit .env. No real credentials belong in this file or in git.
# ============================================================================

# --- LLM provider (pick one preset; all are OpenAI-compatible endpoints) ---
SRE_LLM_PROVIDER=xai            # xai | openrouter | openai | custom
XAI_API_KEY=                    # https://console.x.ai  (Grok credits)
OPENROUTER_API_KEY=             # https://openrouter.ai (free-tier models exist)
OPENAI_API_KEY=                 # only if SRE_LLM_PROVIDER=openai
SRE_LLM_BASE_URL=               # only for provider=custom (e.g. https://openrouter.ai/api/v1)

# Model selection. Per-role vars fall back to SRE_MODEL.
SRE_MODEL=grok-4-fast
SRE_MODEL_COMMANDER=
SRE_MODEL_INVESTIGATOR=
SRE_MODEL_PLANNER=
SRE_MODEL_REPORTER=

# --- LangSmith (optional for local runs; REQUIRED for Harbor `-e langsmith`) ---
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=sentinelsre-agent-traces
LANGSMITH_TRACING=true
LANGSMITH_WORKSPACE_ID=

# --- Runtime mode ---
SRE_ENVIRONMENT=local           # local | harbor-langsmith | harbor-docker
SRE_RUN_MODE=demo               # demo | benchmark
SRE_APPROVAL_MODE=manual        # manual | auto_safe | deny
SRE_DATABASE_URL=sqlite+aiosqlite:///./reports/sentinelsre.db
SRE_ARTIFACT_DIR=./reports
SRE_POLICY_FILE=./configs/policy.yaml
SRE_SERVICE_CONFIG_FILE=./configs/services.yaml
SRE_RUNTIME_DIR=./runtime

# --- Run budgets (spec section 8 defaults) ---
SRE_MAX_MODEL_TURNS=15
SRE_MAX_TOOL_CALLS=35
SRE_MAX_REMEDIATION_ATTEMPTS=2
SRE_MAX_VERIFICATION_RETRIES=3
SRE_MAX_NO_PROGRESS_CYCLES=3
SRE_MAX_LOG_LINES=200
SRE_MAX_TOOL_OUTPUT_BYTES=51200
SRE_MAX_ACTIVE_HYPOTHESES=3
SRE_ACTION_CONFIDENCE_THRESHOLD=0.80
SRE_INCIDENT_TIMEOUT_SECONDS=600

# --- Demo platform ---
SRE_CHECKOUT_PORT=8081
SRE_INVENTORY_PORT=8082

# --- Harbor ---
HARBOR_OUTPUT_DIR=./jobs
HARBOR_LANGSMITH_DATASET=sentinelsre-harbor-tasks
HARBOR_LANGSMITH_EXPERIMENT=baseline-v1
